+// ---- Task 55：补齐 options flags 的影子镜像 ------------------------------
+// 这 8 个无参 setter 原本只经 -reexport_library 透传到 impl：主进程的
+// options 对象配置是正确的，但影子注册表不知道，沙箱子进程重建 options
+// 时全部丢失。MC 26.3 的 #version 330 uniform block 因此报
+// "uniform/buffer blocks require layout(binding=X)"（minecraft:pipeline/gui
+// 编译失败 → 启动崩溃）。关掉沙箱走进程内旧链路能跑，正因为这些 setter
+// 在进程内路径直接作用于 MC 持有的 options 对象。此处转发 impl 并镜像到
+// 影子表；shaderc_sandbox.m 的子进程按 ame_sb_opt_fields_t 调用同名 impl
+// setter 重建等价 options，沙箱保持开启即可正常编译。
+#define AME_SHADERC_FLAG_SETTER(fn, which)                                     \
+void fn(void *options) {                                                       \
+    void *real = ame_shaderc_shim_resolve(#fn);                                \
+    if (real == NULL || options == NULL) return;                              \
+    ((void (*)(void *))real)(options);                                        \
+    ame_opt_shadow_set_int(options, which, 1);                                \
+    fprintf(stderr, "[shaderc-shim] options_set: " #fn " (opt=%p t=%.0fms)\n", \
+            options, ame_shim_ms());                                          \
+}
+AME_SHADERC_FLAG_SETTER(shaderc_compile_options_set_auto_bind_uniforms, 3)
+AME_SHADERC_FLAG_SETTER(shaderc_compile_options_set_auto_map_locations, 4)
+AME_SHADERC_FLAG_SETTER(shaderc_compile_options_set_vulkan_rules_relaxed, 5)
+AME_SHADERC_FLAG_SETTER(shaderc_compile_options_set_invert_y, 6)
+AME_SHADERC_FLAG_SETTER(shaderc_compile_options_set_nan_clamp, 7)
+AME_SHADERC_FLAG_SETTER(shaderc_compile_options_set_suppress_warnings, 8)
+AME_SHADERC_FLAG_SETTER(shaderc_compile_options_set_warnings_as_errors, 9)
+AME_SHADERC_FLAG_SETTER(shaderc_compile_options_set_auto_combined_image_sampler, 10)
+#undef AME_SHADERC_FLAG_SETTER
+
